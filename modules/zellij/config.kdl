keybinds clear-defaults=false {
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    shared {
      bind "Alt 1" { GoToTab 1; SwitchToMode "Locked"; }
      bind "Alt 2" { GoToTab 2; SwitchToMode "Locked"; }
      bind "Alt 3" { GoToTab 3; SwitchToMode "Locked"; }
      bind "Alt 4" { GoToTab 4; SwitchToMode "Locked"; }
      bind "Alt 5" { GoToTab 5; SwitchToMode "Locked"; }
      bind "Alt 6" { GoToTab 6; SwitchToMode "Locked"; }
      bind "Alt 7" { GoToTab 7; SwitchToMode "Locked"; }
      bind "Alt 8" { GoToTab 8; SwitchToMode "Locked"; }
      bind "Alt 9" { GoToTab 9; SwitchToMode "Locked"; }
      bind "Alt f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
      bind "Alt w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
      bind "Alt q" { CloseFocus; SwitchToMode "Locked"; }
      bind "Alt n" { NewPane; }
      bind "Alt c" { CopyLastCommandOutput; }
      bind "Alt v"  { EditScrollback; SwitchToMode "Locked";}
      bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
      bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
      bind "Alt j" "Alt Down" { MoveFocus "Down"; }
      bind "Alt k" "Alt Up" { MoveFocus "Up"; }
      bind "Alt t" { NewTab; SwitchToMode "Locked"; }
      bind "Alt g" {
        Run "lazygit" {
          floating true
          close_on_exit true
        }
        SwitchToMode "Locked";
      }
      bind "Alt y" {
        Run "yazi" {
          floating true
          close_on_exit true
        }
        SwitchToMode "Locked";
      }
      // cc-deck registers its own keys outside locked mode only, so repeat
      // them here to make them work in the default locked mode too.
      bind "Alt s" { MessagePlugin { name "cc-deck:navigate"; }; }
      bind "Alt S" { MessagePlugin { name "cc-deck:navigate-prev"; }; }
      bind "Alt a" { MessagePlugin { name "cc-deck:attend"; }; }
      bind "Alt A" { MessagePlugin { name "cc-deck:attend-prev"; }; }
      bind "Alt e" { MessagePlugin { name "cc-deck:working"; }; }
      bind "Alt E" { MessagePlugin { name "cc-deck:working-prev"; }; }
    }
}

// cc-deck controller: tracks Claude Code sessions across all tabs.
load_plugins {
    "file:@ccDeckWasm@" {
        mode "controller"
        navigate_key "Alt s"
        attend_key "Alt a"
        // Alt w is taken by ToggleFloatingPanes.
        working_key "Alt e"
    }
}

simplified_ui true

pane_frames false 

theme "tokyo-night"

default_layout "sumi"

default_mode "locked"

// Keep mouse-wheel scrolling from switching the session into scroll/normal mode.
scroll_mode_sync false

show_startup_tips true
scrollback_editor "vim"
